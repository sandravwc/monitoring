#!/data/data/com.termux/files/usr/bin/sh
exec 2>&1
exec $HOME/monitoring/bin/alertmanager --config.file=$HOME/monitoring/repo/deploy/alertmanager.yml --storage.path=$HOME/monitoring/alertmanager --web.listen-address=127.0.0.1:9093 --cluster.listen-address=""   # single node; cluster gossip needs netlink, denied on Android
